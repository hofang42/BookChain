<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow network calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allow notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allow vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Foreground service permission (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookChainFE">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Book Detail Activity -->
        <activity
            android:name=".ui.bookdetail.BookDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <!-- Cart Activity -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <!-- Checkout Activity -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false"
            android:parentActivityName=".ui.cart.CartActivity" />

        <!-- Message Activity -->
        <activity
            android:name=".ui.message.MessageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <!-- Chat Detail Activity -->
        <activity
            android:name=".ui.message.ChatDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.message.MessageActivity" />
        
        <!-- Chat Notification Service - Foreground Service -->
        <service
            android:name=".services.ChatNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            
    </application>

</manifest>