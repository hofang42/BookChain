<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allow notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allow vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Foreground service permission (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Image picker permission -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- Location permissions for finding nearby branches -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookChainFE">
        
        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- MAIN ACTIVITY: Giờ đây sẽ đảm nhận cả 2 vai trò -->
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"> <!-- QUAN TRỌNG: Giữ nguyên singleTask -->

            <!-- 1. Vai trò Launcher (Mở app từ icon) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 2. Vai trò hứng Deep Link thanh toán (Đã chuyển từ PaymentHandlerActivity sang) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mybookapp"
                    android:host="payment-status"
                    android:pathPrefix="/result" />
            </intent-filter>
        </activity>

        <!-- Message Activity -->
        <activity
            android:name=".ui.message.MessageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <!-- Chat Detail Activity -->
        <activity
            android:name=".ui.message.ChatDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.message.MessageActivity" />
        
        <!-- Chat Notification Service - Foreground Service -->
        <service
            android:name=".services.ChatNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            
    </application>
</manifest>