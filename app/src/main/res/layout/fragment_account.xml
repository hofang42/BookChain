<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.account.AccountFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/white"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:elevation="0dp"
            app:title="Account"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.Account.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/account_bottom_nav_height"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/account_horizontal_padding"
            android:paddingEnd="@dimen/account_horizontal_padding">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:foregroundGravity="center">

                <!-- Removed dummy top spacer to align avatar precisely under toolbar -->

                <FrameLayout
                    android:layout_width="@dimen/account_avatar_size"
                    android:layout_height="@dimen/account_avatar_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="0dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_black" />

                    <ImageView
                        android:id="@+id/avatar"
                        android:layout_width="@dimen/account_avatar_icon_size"
                        android:layout_height="@dimen/account_avatar_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="profile avatar"
                        android:src="@drawable/ic_person_white"
                        android:tint="@null" />

                </FrameLayout>
            </FrameLayout>

            <!-- Info card style rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:divider="@android:color/transparent"
                android:showDividers="none">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_card_height"
                    android:layout_marginTop="@dimen/account_card_margin_top"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/account_card_gray"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/label_name"
                            android:layout_width="@dimen/account_label_width"
                            android:layout_height="wrap_content"
                            android:text="Name:"
                            style="@style/TextAppearance.Account.Label" />

                        <TextView
                            android:id="@+id/value_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="John Doe"
                            style="@style/TextAppearance.Account.Value"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_card_height"
                    android:layout_marginTop="@dimen/account_card_margin_top"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/account_card_gray">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/label_email"
                            android:layout_width="@dimen/account_label_width"
                            android:layout_height="wrap_content"
                            android:text="E-mail:"
                            style="@style/TextAppearance.Account.Label" />

                        <TextView
                            android:id="@+id/value_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="johndoe123@mail.com"
                            style="@style/TextAppearance.Account.Value"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_card_height"
                    android:layout_marginTop="@dimen/account_card_margin_top"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/account_card_gray">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/label_password"
                            android:layout_width="@dimen/account_label_width"
                            android:layout_height="wrap_content"
                            android:text="Password:"
                            style="@style/TextAppearance.Account.Label" />

                        <TextView
                            android:id="@+id/value_password"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="**********"
                            style="@style/TextAppearance.Account.Value"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_card_height"
                    android:layout_marginTop="@dimen/account_card_margin_top"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/account_card_gray">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/label_phone"
                            android:layout_width="@dimen/account_label_width"
                            android:layout_height="wrap_content"
                            android:text="Phone:"
                            style="@style/TextAppearance.Account.Label" />

                        <TextView
                            android:id="@+id/value_phone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="-"
                            style="@style/TextAppearance.Account.Value"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manage Addresses Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_manage_addresses"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/account_card_height"
                    android:layout_marginTop="@dimen/account_card_margin_top"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/account_card_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Manage Addresses"
                            android:textSize="16sp"
                            android:textColor="@color/accent_black"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/accent_black" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/account_button_height"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:backgroundTint="@color/accent_black"
                    android:textColor="@color/white"
                    app:cornerRadius="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/account_button_height"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Log out"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/accent_black"
                    app:strokeWidth="2dp"
                    android:textColor="@color/accent_black"
                    app:cornerRadius="6dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation moved to activity_account.xml -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>
