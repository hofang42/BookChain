<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btn_close_filter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/tv_reset_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_paper_back"
            android:textAppearance="@style/TextAppearance.Custom.Chip"
            app:chipBackgroundColor="@color/chip_background_color_selector"
            app:chipStrokeColor="@color/chip_stroke_color_selector"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/chip_text_color_selector"
            app:chipCornerRadius="8dp"
            app:chipMinHeight="40dp"
            app:chipStartPadding="16dp"
            app:chipEndPadding="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paper Back"
            android:checked="true"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hardcover"
            android:textAppearance="@style/TextAppearance.Custom.Chip"
            app:chipBackgroundColor="@color/chip_background_color_selector"
            app:chipStrokeColor="@color/chip_stroke_color_selector"
            app:chipStrokeWidth="1dp"
            android:textColor="@color/chip_text_color_selector"
            app:chipCornerRadius="8dp"
            app:chipMinHeight="40dp"
            app:chipStartPadding="16dp"
            app:chipEndPadding="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardcover" />

    </com.google.android.material.chip.ChipGroup>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price Range"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_price_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0-80$"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/range_slider_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="80.0"
        android:stepSize="1.0"
        app:values="@array/initial_range_slider_values"
        app:thumbColor="@color/black"
        app:trackColorActive="@color/black"
        app:trackColorInactive="#DEDEDE"
        app:haloColor="@android:color/transparent"/>

</LinearLayout>